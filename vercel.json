{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/reporting-backlog/backlog.js": {
      "includeFiles": "api/reporting-backlog/_initial-data.json"
    }
  },
  "rewrites": [
    { "source": "/reporting-backlog", "destination": "/reporting-backlog/index.html" }
  ]
}
